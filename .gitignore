# Local reference copies are outside this repository; keep them out if copied back.
Sakura-app/
Sakura-source/

# Python and editor artifacts anywhere in the tree.
**/.venv/
**/.uv-cache/
**/python-runtime/
**/__pycache__/
**/*.egg-info/
build/
dist/
**/.pytest_cache/
**/.vscode/

# Local model data, recordings, account credentials and personal settings.
**/models/
**/samples/*.wav
**/.env
**/.env.*
**/llm_settings.json
**/persona_backup_*.json
**/settings.json
**/dashboard_settings.json
**/qq_settings.json
**/.qq_bridge.lock
**/memory_data/

# Opt-in planning and local emotional-history database.
**/cognition_settings.json
**/conversation_data/
**/logs/
**/owner_link.json
**/qq_identity.json
**/gpt_sovits_settings.json
data/*
!data/.gitkeep
storage_location.json
storage_migration_result.json

# Candidate API routing metadata (credentials stay in .env.local).
**/model_routes.json
**/api_profiles.json
**/model_registry.json

# Local skill grants; never commit enabled external plugin policies.
**/skills_settings.json

# Local B1 autonomy permissions and durable task database.
**/autonomy_settings.json
**/proactive_settings.json
**/private_state/
**/background*.sqlite3*
**/relationship_reviews.sqlite3*
